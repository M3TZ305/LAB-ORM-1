msgid "Arabic"
msgstr "العربية"

msgid "English"
msgstr "English"

msgid "Title"
msgstr "العنوان"

msgid "Content"
msgstr "المحتوى"

msgid "Enter article title..."
msgstr "اكتب عنوان المقال..."

msgid "Enter article content..."
msgstr "اكتب محتوى المقال..."

msgid "Please enter an article title."
msgstr "يرجى إدخال عنوان للمقال."

msgid "The title is too long (maximum 2048 characters)."
msgstr "العنوان طويل جداً (الحد الأقصى 2048 حرفاً)."

msgid "Please enter the article content."
msgstr "يرجى كتابة محتوى المقال."

msgid "Home"
msgstr "الرئيسية"

msgid "About"
msgstr "من نحن"

msgid "Add Post"
msgstr "إضافة مقال"

msgid "Contact Us"
msgstr "تواصل معنا"

msgid "Light Mode"
msgstr "الوضع النهاري"

msgid "Dark Mode"
msgstr "الوضع الليلي"

msgid "Search articles..."
msgstr "ابحث عن مقال..."

msgid "Search Box"
msgstr "مربع البحث"

msgid "Reset"
msgstr "إلغاء"

msgid "Sort Order"
msgstr "ترتيب النتائج"

msgid "No results matched your search for:"
msgstr "لم يتم العثور على أية نتائج مطابقة لبحثك:"

msgid "Back to all articles"
msgstr "العودة لكافة المقالات"

msgid "Cancel"
msgstr "إلغاء"

msgid "Publish Article"
msgstr "نشر المقال"

msgid "About SIYAQ"
msgstr "عن سِياق"

msgid "SIYAQ is a platform for publishing articles and written content on a variety of topics."
msgstr "سِياق منصة لنشر المقالات والكتابات في موضوعات متنوعة."

msgid "Publisher Name"
msgstr "اسم الناشر"

msgid "Publication Date"
msgstr "تاريخ النشر"

msgid "Article Title"
msgstr "عنوان المقال"

msgid "Article Content"
msgstr "محتوى المقال"

msgid "Publisher not specified"
msgstr "الناشر غير محدد"

msgid "Enter publisher name..."
msgstr "اكتب اسم الناشر..."

msgid "Please enter the publisher name."
msgstr "يرجى إدخال اسم الناشر."

msgid "Publisher name cannot exceed 150 characters."
msgstr "اسم الناشر لا يجب أن يتجاوز 150 حرفاً."

msgid "Newest First"
msgstr "الأحدث أولًا"

msgid "Oldest First"
msgstr "الأقدم أولًا"

msgid "Articles"
msgstr "المقالات"

msgid "Read Article"
msgstr "قراءة المقال"

msgid "No articles available"
msgstr "لا توجد مقالات حاليًا"

msgid "All rights reserved"
msgstr "جميع الحقوق محفوظة"

msgid "Publisher name is required."
msgstr "اسم الناشر مطلوب."

msgid "Publisher name must contain at least two characters."
msgstr "يجب أن يحتوي اسم الناشر على حرفين على الأقل."

msgid "Publisher name must contain valid letters and permitted separators."
msgstr "يجب أن يتكون اسم الناشر من حروف، ويمكن استخدام المسافات والفواصل المسموح بها."

msgid "Numbers are not allowed in publisher names."
msgstr "لا يمكن استخدام الأرقام في اسم الناشر."

msgid "Article title is required."
msgstr "عنوان المقال مطلوب."

msgid "Article title must contain at least five characters."
msgstr "يجب أن يتكون العنوان من 5 أحرف على الأقل."

msgid "A title cannot consist only of numbers or symbols."
msgstr "لا يمكن أن يتكون العنوان من أرقام أو رموز فقط."

msgid "Article title exceeds the maximum allowed length."
msgstr "تجاوز العنوان الحد الأقصى المسموح."

msgid "Article content is required."
msgstr "محتوى المقال مطلوب."

msgid "Article content must contain at least 30 non-whitespace characters."
msgstr "يجب ألا يقل محتوى المقال عن 30 حرفًا فعليًا."

msgid "Article content must contain written text, not only numbers or symbols."
msgstr "يجب أن يحتوي المحتوى على نص مكتوب، وليس أرقامًا أو رموزًا فقط."
